<Page
    x:Class="Jnana.Views.SamplesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jnana.Vanara.Controls">

    <Grid ColumnSpacing="24" Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Style="{StaticResource TitleMediumTextBlockStyle}" Text="Samples" />
            <!-- ItemsSource="{x:Bind ViewModel.Categories}" -->
            <TreeView >
                <!-- Category Template -->
            </TreeView>
        </StackPanel>
        <ScrollViewer Grid.Column="1">
            <!-- ItemsSource="{x:Bind ViewModel.FilteredSamples}" -->
            <ItemsRepeater >
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinColumnSpacing="16"
                                       MinRowSpacing="16"
                                       ItemsJustification="Start"
                                       MinItemWidth="260"/>
                </ItemsRepeater.Layout>
                <!--<ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SampleInfo">
                        --><!--<controls:FeatureCard Title="{x:Bind Title}"
                                              Subtitle="{x:Bind Description}"
                                              Icon="{x:Bind Icon}"
                                              Command="{x:Bind SelectCommand}"/>--><!--
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>-->
            </ItemsRepeater>
        </ScrollViewer>
        <Border x:Name="previousPane" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
            <StackPanel Spacing="16">
                
                <!--<TextBlock Text="{x:Bind ViewModel.SelectedSample.Title}"
                           Style="{StaticResource TitleMediumTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.SelectedSample.Description}"
                           TextWrapping="Wrap"/>-->
                <!--<controls:CodeTabs CodeFiles="{x:Bind ViewModel.SelectedSample.CodeFiles}"/>
                <controls:ApiLinkList Items="{x:Bind ViewModel.SelectedSample.ApiLinks}"/>-->
                <!--<Button Content="Run Sample"
                        Command="{x:Bind ViewModel.RunSelectedSampleCommand}"/>-->
            </StackPanel>
        </Border>

    </Grid>
</Page>
