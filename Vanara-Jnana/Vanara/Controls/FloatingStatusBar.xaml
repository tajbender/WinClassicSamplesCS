<UserControl
    x:Class="Jnana.Vanara.Controls.FloatingStatusBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Vanara.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">

    <FrameworkElement.Height>56</FrameworkElement.Height>

    <Grid x:Name="ControlRoot"
          CornerRadius="8"
          Padding="12,6"
          Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="3"
          MinHeight="42"
          Translation="0,20,0">

        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="IconElement" Glyph="&#xE946;" Opacity="0.8"/>
            <TextBlock x:Name="MessageElement" FontSize="14" Text="Ready." VerticalAlignment="Center"/>
            <FontIcon x:Name="Resizer" Glyph="&#xE7C1;" HorizontalAlignment="Right" Opacity="0.66" VerticalAlignment="Bottom" />
        </StackPanel>
    </Grid>
</UserControl>
