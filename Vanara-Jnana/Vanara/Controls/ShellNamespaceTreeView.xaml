<UserControl
    x:Class="Jnana.Vanara.Controls.ShellNamespaceTreeView"
    xmlns:controls="using:Jnana.Vanara.Controls" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Width="Auto"
    Height="Auto">

    <Grid x:Name="Root"
          CornerRadius="8"
          Padding="12,6"
          Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          Opacity="0"
          Translation="0,20,0">

        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="IconElement"
                      Glyph="&#xE946;"
                      FontSize="14"
                      Opacity="0.8"/>

            <TextBlock x:Name="MessageElement"
                       Text="Status"
                       FontSize="14"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <TreeView x:Name="NamespaceTreeView" Margin="0,8,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
